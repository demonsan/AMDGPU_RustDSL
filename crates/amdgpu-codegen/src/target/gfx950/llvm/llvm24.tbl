# MOp -> post-RA LLVM MIR table for AMD LLVM 20.0.0git (ROCm 7.0.2), gfx950.
#
# Row format:   Key | signature | MIR text
#   Key        MOp variant name, optionally ':kinds' where kinds has one char per source,
#              r = register, i = immediate ('-' = no sources). The most specific row wins.
#   signature  'DST <- SRC SRC ...' with classes V1 V2 V4 V8 V16 S1 S2 and I (immediate).
#              Used by the probe test to build one tiny MIR per row.
#   MIR text   one MachineInstr; ' ;; ' separates several. Tokens:
#     {d} {d.K}    destination register (K-th dword)       {sN} {sN.K}  source N (register or immediate)
#     {i0}         source 0 if immediate else inst.imm      {imm} {imm32}  inst.imm
#     {dsub}       $vgpr (dst base + imm)                   {s0sub}  $vgpr (src0 base + imm)
#     {pv} {ps}    physical $vgpr<imm> / $sgpr<imm>          {vmcnt} {lgkmcnt}  S_WAITCNT immediates
#     {t}          branch target block
#
# Dropped on purpose: SNop (LLVM recomputes hazards).

VMovB32:r   | V1 <- V1 | {d} = V_MOV_B32_e32 {s0}, implicit $exec
VMovB32:i   | V1 <- I  | {d} = V_MOV_B32_e32 {s0}, implicit $exec
VMovB32:-   | V1 <-    | {d} = V_MOV_B32_e32 {imm32}, implicit $exec
VMovFromS   | V1 <- S1 | {d} = V_MOV_B32_e32 {s0}, implicit $exec
VMovFromSPair | V2 <- S2 | {d.0} = V_MOV_B32_e32 {s0.0}, implicit $exec ;; {d.1} = V_MOV_B32_e32 {s0.1}, implicit $exec
VAccvgprRead | V1 <- A1 | {d} = V_ACCVGPR_READ_B32_e64 {s0}, implicit $exec
VAccvgprWrite:r | A1 <- V1 | {d} = V_ACCVGPR_WRITE_B32_e64 {s0}, implicit $exec
VAccvgprWrite:i | A1 <- I | {d} = V_ACCVGPR_WRITE_B32_e64 {s0}, implicit $exec
VAccvgprMov | A1 <- A1 | {d} = V_ACCVGPR_MOV_B32 {s0}, implicit $exec
VPtrAdd:rr  | V2 <- V2 V1 | {d.0} = V_ADD_CO_U32_e32 {s1}, {s0.0}, implicit-def $vcc, implicit $exec ;; {d.1}, $vcc = V_ADDC_U32_e64 {s0.1}, 0, $vcc, 0, implicit $exec
VPtrAdd:ri  | V2 <- V2 I | {d.0}, $vcc = V_ADD_CO_U32_e64 {s0.0}, {s1}, 0, implicit $exec ;; {d.1}, $vcc = V_ADDC_U32_e64 {s0.1}, 0, $vcc, 0, implicit $exec
VReadPhys   | V1 <-    | {d} = V_MOV_B32_e32 {pv}, implicit $exec
VReadFirstLane | S1 <- V1 | {d} = V_READFIRSTLANE_B32 {s0}, implicit $exec
VCvtPknormU16 | V1 <- V1 V1 | {d} = nofpexcept V_CVT_PKNORM_U16_F32_e64 0, {s0}, 0, {s1}, 0, implicit $mode, implicit $exec
VCvtPkFp8F32 | V1 <- V1 V1 | {d} = nofpexcept V_CVT_PK_FP8_F32_e64 0, {s0}, 0, {s1}, {d}(tied-def 0), 0, implicit $mode, implicit $exec
VCvtPkBf16F32 | V1 <- V1 V1 | {d} = nofpexcept V_CVT_PK_BF16_F32_e64 0, {s0}, 0, {s1}, 0, 0, implicit $mode, implicit $exec
VCvtPkFp8Lo | V1 <- V1 V1 | {d} = nofpexcept V_CVT_SCALEF32_PK_FP8_BF16_e64 0, {s0}, 0, {s1}, {d}(tied-def 0), 0, implicit $mode, implicit $exec
VCvtPkFp8Hi | V1 <- V1 V1 | {d} = nofpexcept V_CVT_SCALEF32_PK_FP8_BF16_e64 8, {s0}, 0, {s1}, {d}(tied-def 0), 4, implicit $mode, implicit $exec
VAddU32     | V1 <- V1 V1 | {d} = V_ADD_U32_e32 {s0}, {s1}, implicit $exec
VAddCoU32:rr | V1 <- V1 V1 | {d} = V_ADD_CO_U32_e32 {s0}, {s1}, implicit-def $vcc, implicit $exec
VAddCoU32:ir | V1 <- I V1  | {d} = V_ADD_CO_U32_e32 {s0}, {s1}, implicit-def $vcc, implicit $exec
VAddCoU32:ri | V1 <- V1 I  | {d}, $vcc = V_ADD_CO_U32_e64 {s0}, {s1}, 0, implicit $exec
VAddCoU32:ii | V1 <- I I   | {d}, $vcc = V_ADD_CO_U32_e64 {s0}, {s1}, 0, implicit $exec
VAddcCoU32:rr | V1 <- V1 V1 | {d} = V_ADDC_U32_e32 {s0}, {s1}, implicit-def $vcc, implicit $vcc, implicit $exec
VAddcCoU32:ir | V1 <- I V1  | {d} = V_ADDC_U32_e32 {s0}, {s1}, implicit-def $vcc, implicit $vcc, implicit $exec
VAddcCoU32:ri | V1 <- V1 I  | {d}, $vcc = V_ADDC_U32_e64 {s0}, {s1}, $vcc, 0, implicit $exec
VAddcCoU32:ii | V1 <- I I   | {d}, $vcc = V_ADDC_U32_e64 {s0}, {s1}, $vcc, 0, implicit $exec
VAddF32     | V1 <- V1 V1 | {d} = nofpexcept V_ADD_F32_e32 {s0}, {s1}, implicit $mode, implicit $exec
VSubF32     | V1 <- V1 V1 | {d} = nofpexcept V_SUB_F32_e32 {s0}, {s1}, implicit $mode, implicit $exec
VMulF32     | V1 <- V1 V1 | {d} = nofpexcept V_MUL_F32_e32 {s0}, {s1}, implicit $mode, implicit $exec
VMaxF32     | V1 <- V1 V1 | {d} = nofpexcept V_MAX_F32_e32 {s0}, {s1}, implicit $mode, implicit $exec
VPkSubU16   | V1 <- V1 V1 | {d} = V_PK_SUB_U16 8, {s0}, 8, {s1}, 0, 0, 0, 0, 0, implicit $exec
VPermB32    | V1 <- V1 V1 V1 | {d} = V_PERM_B32_e64 {s0}, {s1}, {s2}, implicit $exec
VMax3F32    | V1 <- V1 V1 V1 | {d} = nofpexcept V_MAX3_F32_e64 0, {s0}, 0, {s1}, 0, {s2}, 0, 0, implicit $mode, implicit $exec
VFmaF32     | V1 <- V1 V1 V1 | {d} = nofpexcept V_FMA_F32_e64 0, {s0}, 0, {s1}, 0, {s2}, 0, 0, implicit $mode, implicit $exec
VExpF32     | V1 <- V1 | {d} = nofpexcept V_EXP_F32_e32 {s0}, implicit $mode, implicit $exec
VLogF32     | V1 <- V1 | {d} = nofpexcept V_LOG_F32_e32 {s0}, implicit $mode, implicit $exec
VRcpF32     | V1 <- V1 | {d} = nofpexcept V_RCP_F32_e32 {s0}, implicit $mode, implicit $exec
VCvtF32F16  | V1 <- V1 | {d} = nofpexcept V_CVT_F32_F16_e32 {s0}, implicit $mode, implicit $exec
VCvtF16F32  | V1 <- V1 | {d} = nofpexcept V_CVT_F16_F32_e32 {s0}, implicit $mode, implicit $exec
VAndB32     | V1 <- V1 V1 | {d} = V_AND_B32_e32 {s0}, {s1}, implicit $exec
VMinI32     | V1 <- V1 V1 | {d} = V_MIN_I32_e32 {s0}, {s1}, implicit $exec
VPkFmaF32 | V2 <- V2 V2 V2 | {d} = nofpexcept V_PK_FMA_F32 8, {s0}, 8, {s1}, 8, {s2}, 0, 0, -1, 0, 0, implicit $mode, implicit $exec
SMulHiU32 | S1 <- S1 S1 | {d} = S_MUL_HI_U32 {s0}, {s1}
VMadU64U32:rrr | V2 <- V1 V1 V2 | {d}, $vcc = V_MAD_U64_U32_e64 {s0}, {s1}, {s2}, 0, implicit $exec
VMadU64U32:rir | V2 <- V1 I V2 | {d}, $vcc = V_MAD_U64_U32_e64 {s0}, {s1}, {s2}, 0, implicit $exec
VMadU64U32:irr | V2 <- I V1 V2 | {d}, $vcc = V_MAD_U64_U32_e64 {s0}, {s1}, {s2}, 0, implicit $exec
VReadLane | S1 <- V1 | {d} = V_READLANE_B32 {s0}, {lane}, implicit $exec
VWriteLane | V1 <- S1 V1 | {d} = V_WRITELANE_B32 {s0}, {lane}, {d}(tied-def 0), implicit $exec
VMbcntLo | V1 <- V1 V1 | {d} = V_MBCNT_LO_U32_B32_e64 {s0}, {s1}, implicit $exec
VMbcntHi | V1 <- V1 V1 | {d} = V_MBCNT_HI_U32_B32_e64 {s0}, {s1}, implicit $exec
VBcntU32 | V1 <- V1 V1 | {d} = V_BCNT_U32_B32_e64 {s0}, {s1}, implicit $exec
VFfblB32 | V1 <- V1 | {d} = V_FFBL_B32_e32 {s0}, implicit $exec
VFfbhU32 | V1 <- V1 | {d} = V_FFBH_U32_e32 {s0}, implicit $exec
VCmpMaskNeU32 | S2 <- V1 V1 | {d} = V_CMP_NE_U32_e64 {s0}, {s1}, implicit $exec
SMaskLo | S1 <- S2 | {d} = S_MOV_B32 {s0.0}
SMaskHi | S1 <- S2 | {d} = S_MOV_B32 {s0.1}
LdsBpermute | V1 <- V1 V1 | {d} = DS_BPERMUTE_B32 {s0}, {s1}, {imm}, implicit $exec
LdsPermute | V1 <- V1 V1 | {d} = DS_PERMUTE_B32 {s0}, {s1}, {imm}, implicit $exec
LdsSwizzle | V1 <- V1 | {d} = DS_SWIZZLE_B32 {s0}, {imm}, 0, implicit $exec
VCvtPkF32Fp8 | V2 <- V1 | {d} = V_CVT_PK_F32_FP8_sdwa 0, {s0}, 0, 0, {sdwaword}, implicit $mode, implicit $exec
VCvtF32Fp8 | V1 <- V1 | {d} = V_CVT_F32_FP8_sdwa 0, {s0}, 0, 0, {byte}, implicit $mode, implicit $exec
VCvtPkF32Bf8 | V2 <- V1 | {d} = V_CVT_PK_F32_BF8_sdwa 0, {s0}, 0, 0, {sdwaword}, implicit $mode, implicit $exec
VCvtF32Bf8 | V1 <- V1 | {d} = V_CVT_F32_BF8_sdwa 0, {s0}, 0, 0, {byte}, implicit $mode, implicit $exec
VCvtPkBf8F32 | V1 <- V1 V1 | {d} = V_CVT_PK_BF8_F32_e64 {m8}, {s0}, 0, {s1}, {d}(tied-def 0), 0, implicit $mode, implicit $exec
VCvtScalePkBf16Fp8 | V1 <- V1 V1 | {d} = V_CVT_SCALEF32_PK_BF16_FP8_e64 {m4}, {s0}, 0, {s1}, 0, implicit $mode, implicit $exec
VCvtScalePkF16Fp8 | V1 <- V1 V1 | {d} = V_CVT_SCALEF32_PK_F16_FP8_e64 {m4}, {s0}, 0, {s1}, 0, implicit $mode, implicit $exec
VCvtScalePkBf16Bf8 | V1 <- V1 V1 | {d} = V_CVT_SCALEF32_PK_BF16_BF8_e64 {m4}, {s0}, 0, {s1}, 0, implicit $mode, implicit $exec
VCvtScalePkF16Bf8 | V1 <- V1 V1 | {d} = V_CVT_SCALEF32_PK_F16_BF8_e64 {m4}, {s0}, 0, {s1}, 0, implicit $mode, implicit $exec
VCvtScalePkF32Fp8 | V2 <- V1 V1 | {d} = V_CVT_SCALEF32_PK_F32_FP8_e64 {m4}, {s0}, 0, {s1}, 0, implicit $mode, implicit $exec
VCvtScalePkF32Bf8 | V2 <- V1 V1 | {d} = V_CVT_SCALEF32_PK_F32_BF8_e64 {m4}, {s0}, 0, {s1}, 0, implicit $mode, implicit $exec
VCvtScalePkF32Fp4 | V2 <- V1 V1 | {d} = V_CVT_SCALEF32_PK_F32_FP4_e64 {b0m4}, {s0}, {b1m4}, {s1}, 0, implicit $mode, implicit $exec
VCvtScale2xPk16Fp6F32 | V8 <- V16 V16 V1 | {dt6} = V_CVT_SCALEF32_2XPK16_FP6_F32_e64 {s0}, {s1}, {s2}, implicit $mode, implicit $exec
VCvtScale2xPk16Bf6F32 | V8 <- V16 V16 V1 | {dt6} = V_CVT_SCALEF32_2XPK16_BF6_F32_e64 {s0}, {s1}, {s2}, implicit $mode, implicit $exec
VCvtScalePk32Fp6F16 | V8 <- V16 V1 | {dt6} = V_CVT_SCALEF32_PK32_FP6_F16_e64 {s0}, {s1}, implicit $mode, implicit $exec
VCvtScalePk32Fp6Bf16 | V8 <- V16 V1 | {dt6} = V_CVT_SCALEF32_PK32_FP6_BF16_e64 {s0}, {s1}, implicit $mode, implicit $exec
VCvtScalePk32Bf6F16 | V8 <- V16 V1 | {dt6} = V_CVT_SCALEF32_PK32_BF6_F16_e64 {s0}, {s1}, implicit $mode, implicit $exec
VCvtScalePk32Bf6Bf16 | V8 <- V16 V1 | {dt6} = V_CVT_SCALEF32_PK32_BF6_BF16_e64 {s0}, {s1}, implicit $mode, implicit $exec
VCvtScalePk32F16Fp6 | V16 <- V8 V1 | {d} = V_CVT_SCALEF32_PK32_F16_FP6_e64 {s0t6}, {s1}, implicit $mode, implicit $exec
VCvtScalePk32Bf16Fp6 | V16 <- V8 V1 | {d} = V_CVT_SCALEF32_PK32_BF16_FP6_e64 {s0t6}, {s1}, implicit $mode, implicit $exec
VCvtScalePk32F16Bf6 | V16 <- V8 V1 | {d} = V_CVT_SCALEF32_PK32_F16_BF6_e64 {s0t6}, {s1}, implicit $mode, implicit $exec
VCvtScalePk32Bf16Bf6 | V16 <- V8 V1 | {d} = V_CVT_SCALEF32_PK32_BF16_BF6_e64 {s0t6}, {s1}, implicit $mode, implicit $exec
VCvtScalePkBf16Fp4 | V1 <- V1 V1 | {d} = V_CVT_SCALEF32_PK_BF16_FP4_e64 {b0m4}, {s0}, {b1m4}, {s1}, 0, implicit $mode, implicit $exec
VCvtScalePkF16Fp4 | V1 <- V1 V1 | {d} = V_CVT_SCALEF32_PK_F16_FP4_e64 {b0m4}, {s0}, {b1m4}, {s1}, 0, implicit $mode, implicit $exec
VCvtScalePkFp8F32 | V1 <- V1 V1 V1 | {d} = V_CVT_SCALEF32_PK_FP8_F32_e64 {m8}, {s0}, 0, {s1}, 0, {s2}, {d}(tied-def 0), 0, implicit $mode, implicit $exec
VCvtScalePkBf8F32 | V1 <- V1 V1 V1 | {d} = V_CVT_SCALEF32_PK_BF8_F32_e64 {m8}, {s0}, 0, {s1}, 0, {s2}, {d}(tied-def 0), 0, implicit $mode, implicit $exec
VCvtScalePkFp4F32 | V1 <- V1 V1 V1 | {d} = V_CVT_SCALEF32_PK_FP4_F32_e64 {b1m8}, {s0}, 0, {s1}, {b0m4}, {s2}, {d}(tied-def 0), 0, implicit $mode, implicit $exec
VCvtPkU8F32 | V1 <- V1 V1 | {d} = nofpexcept V_CVT_PK_U8_F32_e64 0, {s0}, 0, {byte}, 0, {s1}, 0, implicit $mode, implicit $exec
VCvtPkI16I32 | V1 <- V1 V1 | {d} = V_CVT_PK_I16_I32_e64 {s0}, {s1}, implicit $exec
VCvtPkU16U32 | V1 <- V1 V1 | {d} = V_CVT_PK_U16_U32_e64 {s0}, {s1}, implicit $exec
VFloorF32   | V1 <- V1 | {d} = nofpexcept V_FLOOR_F32_e32 {s0}, implicit $mode, implicit $exec
VCeilF32    | V1 <- V1 | {d} = nofpexcept V_CEIL_F32_e32 {s0}, implicit $mode, implicit $exec
VTruncF32   | V1 <- V1 | {d} = nofpexcept V_TRUNC_F32_e32 {s0}, implicit $mode, implicit $exec
