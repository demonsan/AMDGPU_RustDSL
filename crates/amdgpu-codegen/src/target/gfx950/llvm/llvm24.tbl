VSmfmac16x16x128Fp8 | V4 <- V4 V8 V1 | {d} = V_SMFMAC_F32_16X16X128_FP8_FP8_e64 {s0}, {s1}, {s2}, 0, 0, {d}, implicit $mode, implicit $exec
SLshrB32    | S1 <- S1 I  | {d} = S_LSHR_B32 {s0}, {s1}, implicit-def $scc
SAndB32     | S1 <- S1 S1 | {d} = S_AND_B32 {s0}, {s1}, implicit-def $scc
SXorB32     | S1 <- S1 S1 | {d} = S_XOR_B32 {s0}, {s1}, implicit-def $scc
SSubU32     | S1 <- S1 S1 | {d} = S_SUB_U32 {s0}, {s1}, implicit-def $scc
SOrB32      | S1 <- S1 S1 | {d} = S_OR_B32 {s0}, {s1}, implicit-def $scc
SCmpLtI32   | <- S1 S1 | S_CMP_LT_I32 {s0}, {s1}, implicit-def $scc
SCmpEqU32   | <- S1 S1 | S_CMP_EQ_U32 {s0}, {s1}, implicit-def $scc
SCmpGeU32   | <- S1 S1 | S_CMP_GE_U32 {s0}, {s1}, implicit-def $scc
SCmpLeU32   | <- S1 S1 | S_CMP_LE_U32 {s0}, {s1}, implicit-def $scc
VCvtPkFp8F32Hi | V1 <- V1 V1 | {d} = nofpexcept V_CVT_PK_FP8_F32_e64 8, {s0}, 0, {s1}, {d}(tied-def 0), 4, implicit $mode, implicit $exec
VPkAddF32   | V2 <- V2 V2 | {d} = nofpexcept V_PK_ADD_F32 8, {s0}, 8, {s1}, 0, 0, -1, 0, 0, implicit $mode, implicit $exec
VPkMulF32   | V2 <- V2 V2 | {d} = nofpexcept V_PK_MUL_F32 8, {s0}, 8, {s1}, 0, 0, -1, 0, 0, implicit $mode, implicit $exec
VPermlane32Swap | V1 <- V1 V1 | {s0}, {s1} = V_PERMLANE32_SWAP_B32_e32 {s0}(tied-def 0), {s1}(tied-def 1), implicit $exec
VPermlane16Swap | V1 <- V1 V1 | {s0}, {s1} = V_PERMLANE16_SWAP_B32_e32 {s0}(tied-def 0), {s1}(tied-def 1), implicit $exec
SSetPrio    | <- | S_SETPRIO {imm}
SNop        | <- | DROP
SchedGroup | <- | DROP
SWaitVm     | <- | S_WAITCNT {vmcnt}
SWaitLgkm   | <- | S_WAITCNT {lgkmcnt}
SEndpgm     | <- | S_ENDPGM 0

# terminators
T_Goto      | <- | S_BRANCH {t}
T_Scc0      | <- | S_CBRANCH_SCC0 {t}, implicit $scc
T_Scc1      | <- | S_CBRANCH_SCC1 {t}, implicit $scc
T_Vccnz     | <- | S_CBRANCH_VCCNZ {t}, implicit $vcc
T_Vccz      | <- | S_CBRANCH_VCCZ {t}, implicit $vcc
T_Endpgm    | <- | S_ENDPGM 0
# oracle tooling: unique block marker (not a hazard)
X_Marker    | <- | S_SETPRIO {imm}
X_Sep       | <- | S_NOP 15
X_Drain     | <- | S_WAITCNT 0

# ---- MUBUF (buffer) memory ops: srcs [rsrc S4, voffset (V1 = OFFEN, I = the OFFSET form), soffset (S1 or I)]; stores [data, rsrc, voffset, soffset]. The LDS-DMA forms are own-only (like global_load_lds).
SBufferRsrcDyn | S4 <- S2 S1 | {d.0} = S_MOV_B32 {s0.0} ;; {d.1} = S_AND_B32 {s0.1}, 65535, implicit-def dead $scc ;; {d.2} = S_MOV_B32 {s1} ;; {d.3} = S_MOV_B32 131072
SBufferRsrc | S4 <- S2 | {d.0} = S_MOV_B32 {s0.0} ;; {d.1} = S_AND_B32 {s0.1}, 65535, implicit-def dead $scc ;; {d.2} = S_MOV_B32 {imm32} ;; {d.3} = S_MOV_B32 131072
BufferLoadDwordX1:rrr | V1 <- S4 V1 S1 | {d} = BUFFER_LOAD_DWORD_OFFEN {s1}, {s0}, {s2}, {imm}, {cpol}, 0, implicit $exec :: (load (s32), addrspace 8)
BufferLoadDwordX1:rri | V1 <- S4 V1 I | {d} = BUFFER_LOAD_DWORD_OFFEN {s1}, {s0}, {s2}, {imm}, {cpol}, 0, implicit $exec :: (load (s32), addrspace 8)
BufferLoadDwordX1:rir | V1 <- S4 I S1 | {d} = BUFFER_LOAD_DWORD_OFFSET {s0}, {s2}, {imm}, {cpol}, 0, implicit $exec :: (load (s32), addrspace 8)
BufferLoadDwordX1:rii | V1 <- S4 I I | {d} = BUFFER_LOAD_DWORD_OFFSET {s0}, {s2}, {imm}, {cpol}, 0, implicit $exec :: (load (s32), addrspace 8)
BufferLoadDwordX2:rrr | V2 <- S4 V1 S1 | {d} = BUFFER_LOAD_DWORDX2_OFFEN {s1}, {s0}, {s2}, {imm}, {cpol}, 0, implicit $exec :: (load (s64), addrspace 8)
BufferLoadDwordX2:rri | V2 <- S4 V1 I | {d} = BUFFER_LOAD_DWORDX2_OFFEN {s1}, {s0}, {s2}, {imm}, {cpol}, 0, implicit $exec :: (load (s64), addrspace 8)
BufferLoadDwordX2:rir | V2 <- S4 I S1 | {d} = BUFFER_LOAD_DWORDX2_OFFSET {s0}, {s2}, {imm}, {cpol}, 0, implicit $exec :: (load (s64), addrspace 8)
BufferLoadDwordX2:rii | V2 <- S4 I I | {d} = BUFFER_LOAD_DWORDX2_OFFSET {s0}, {s2}, {imm}, {cpol}, 0, implicit $exec :: (load (s64), addrspace 8)
BufferLoadDwordX4:rrr | V4 <- S4 V1 S1 | {d} = BUFFER_LOAD_DWORDX4_OFFEN {s1}, {s0}, {s2}, {imm}, {cpol}, 0, implicit $exec :: (load (s128), addrspace 8)
BufferLoadDwordX4:rri | V4 <- S4 V1 I | {d} = BUFFER_LOAD_DWORDX4_OFFEN {s1}, {s0}, {s2}, {imm}, {cpol}, 0, implicit $exec :: (load (s128), addrspace 8)
