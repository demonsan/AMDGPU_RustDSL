BufferLoadDwordX4:rii | V4 <- S4 I I | {d} = BUFFER_LOAD_DWORDX4_OFFSET {s0}, {s2}, {imm}, {cpol}, 0, implicit $exec :: (load (s128), addrspace 8)
BufferStoreDwordX1:rrrr | <- V1 S4 V1 S1 | BUFFER_STORE_DWORD_OFFEN {s0}, {s2}, {s1}, {s3}, {imm}, {cpol}, 0, implicit $exec :: (store (s32), addrspace 8)
BufferStoreDwordX1:rrri | <- V1 S4 V1 I | BUFFER_STORE_DWORD_OFFEN {s0}, {s2}, {s1}, {s3}, {imm}, {cpol}, 0, implicit $exec :: (store (s32), addrspace 8)
BufferStoreDwordX1:rrir | <- V1 S4 I S1 | BUFFER_STORE_DWORD_OFFSET {s0}, {s1}, {s3}, {imm}, {cpol}, 0, implicit $exec :: (store (s32), addrspace 8)
BufferStoreDwordX1:rrii | <- V1 S4 I I | BUFFER_STORE_DWORD_OFFSET {s0}, {s1}, {s3}, {imm}, {cpol}, 0, implicit $exec :: (store (s32), addrspace 8)
BufferStoreDwordX2:rrrr | <- V2 S4 V1 S1 | BUFFER_STORE_DWORDX2_OFFEN {s0}, {s2}, {s1}, {s3}, {imm}, {cpol}, 0, implicit $exec :: (store (s64), addrspace 8)
