# Rust build container for AMDGPU_RustDSL.
#
# The toolchain lives only inside this image; the host and the shared home
# directory are never modified. Rebuild with tools/container/build.sh.
FROM docker.io/library/ubuntu:22.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl build-essential \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rust/rustup \
    CARGO_HOME=/opt/rust/cargo
ENV PATH=/opt/rust/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN curl -sSf https://sh.rustup.rs -o /tmp/rustup.sh \
    && sh /tmp/rustup.sh -y --profile minimal --default-toolchain 1.83.0 --no-modify-path \
    && rm -f /tmp/rustup.sh \
    && cargo --version \
    && rustc --version

WORKDIR /work
