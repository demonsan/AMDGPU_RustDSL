{ "tensors": { "x": {"dtype": "bf16", "shape": ["M", 4096]}, "r": {"dtype": "bf16", "shape": ["M", 4096]}, "g1": {"dtype": "bf16", "shape": [4096]},
    "h": {"dtype": "bf16", "shape": ["M", 4096]}, "y": {"dtype": "bf16", "shape": ["M", 4096]}, "q": {"dtype": "fp8", "shape": ["M", 4096]}, "s": {"dtype": "f32", "shape": ["M"]},
    "u": {"dtype": "bf16", "shape": ["M", 8192]}, "a": {"dtype": "bf16", "shape": ["M", 4096]}, "aq": {"dtype": "fp8", "shape": ["M", 4096]}, "as": {"dtype": "f32", "shape": ["M"]} },
  "dims": {"M": 64},
  "ops": [ {"id": "res", "op": "add", "in": ["x", "r"], "out": ["h"]},
           {"id": "norm", "op": "rmsnorm", "in": ["h", "g1"], "out": ["y"]},
           {"id": "quant", "op": "quant_token", "in": ["y"], "out": ["q", "s"], "attrs": {"to": "fp8"}},
           {"id": "act", "op": "act_mul", "in": ["u"], "out": ["a"], "attrs": {"act": "silu"}},
           {"id": "aquant", "op": "quant_token", "in": ["a"], "out": ["aq", "as"], "attrs": {"to": "fp8"}} ],
  "outputs": ["h", "q", "s", "aq", "as"] }
