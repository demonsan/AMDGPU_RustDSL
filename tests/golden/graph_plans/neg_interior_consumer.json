{ "tensors": { "x": {"dtype": "bf16", "shape": ["M", 4096]}, "g": {"dtype": "bf16", "shape": [4096]}, "y": {"dtype": "bf16", "shape": ["M", 4096]},
    "q": {"dtype": "fp8", "shape": ["M", 4096]}, "s": {"dtype": "f32", "shape": ["M"]}, "q8": {"dtype": "i8", "shape": ["M", 4096]}, "s8": {"dtype": "f32", "shape": ["M"]} },
  "dims": {"M": 256},
  "ops": [ {"id": "norm", "op": "rmsnorm", "in": ["x", "g"], "out": ["y"]},
           {"id": "quant", "op": "quant_token", "in": ["y"], "out": ["q", "s"], "attrs": {"to": "fp8"}},
           {"id": "quant8", "op": "quant_token", "in": ["y"], "out": ["q8", "s8"], "attrs": {"to": "int8"}} ],
  "outputs": ["q", "s", "q8", "s8"] }
